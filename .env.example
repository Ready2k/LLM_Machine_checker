# Copy to .env (gitignored) and fill in. Loaded by manage.sh and the systemd unit.

# Comma-separated API keys. Non-loopback clients must send one as
# "Authorization: Bearer <key>" or "x-api-key: <key>". Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
GATEWAY_API_KEYS=
# Optional per-key privacy floor: "key:tier" (public|personal|confidential|restricted).
# A client using that key can't declare a less sensitive tier, e.g. a phone key
# "abc123:personal" can never reach routes that only allow "public" (cloud).
#   GATEWAY_API_KEYS=phonekey:personal,laptopkey

# Shared secret between the gateway and every node agent (same value everywhere).
AGENT_SECRET=

# Optional: SearXNG node for web grounding (overrides config/tools.yaml).
# SEARXNG_URL=http://searxng.lan:8080
